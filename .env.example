# Canonical league for `/` redirect (must match `leagues.slug` in Supabase)
NEXT_PUBLIC_DEFAULT_LEAGUE_SLUG=

# Optional: default "you" on the standings chart (Supabase managers.id)
NEXT_PUBLIC_MY_MANAGER_ID=

# --- Optional: in-app match entry at /admin/match-results (see docs/WEEKLY_WORKFLOW.md)
# Service role key (server only, never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=
# Shared secret you re-type in the admin form on each submit
# ADMIN_MATCH_ENTRY_SECRET=
